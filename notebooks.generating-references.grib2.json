ound will be a coordinate of interest.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iXIzKx67fU"}],"key":"bT6HKtiTqI"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We also write a separate JSON for each of the selected message, since these are the basic component data sets (see the loop over ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Osa0CxyiiN"},{"type":"inlineCode","value":"out","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"DDUFFQNJD6"},{"type":"text","value":").","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Bsj1ho0BZ5"}],"key":"EFp3sk3cdq"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"strong","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Note","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"TUbiBisBJA"}],"key":"vT5Ksbqx0t"},{"type":"text","value":": ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"a14SR7ynjp"},{"type":"inlineCode","value":"scan_grib","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"sk4pqv13dU"},{"type":"text","value":" does not require a filter and will happily create a reference file for each available grib message. However when combining the grib messages using ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"FwWs9XKdxE"},{"type":"inlineCode","value":"MultiZarrToZarr","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"T3FZT3KrFN"},{"type":"text","value":" it is necessary for the messages to share a coordinate system. Thus to make our lives easier and ensure all reference outputs from ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key"